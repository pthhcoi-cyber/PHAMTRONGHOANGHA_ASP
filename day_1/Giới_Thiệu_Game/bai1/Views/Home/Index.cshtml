@{ Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GameVerse – Khám Phá Thế Giới Game Đỉnh Cao</title>
    <meta name="description" content="GameVerse – Nền tảng khám phá game số 1 Việt Nam. RPG, Shooter, Esports, Chiến thuật, Thể thao, Kinh dị và nhiều hơn nữa." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/gameverse.css" asp-append-version="true" />
</head>
<body>

    <!-- =========================================================
       LOADING SCREEN
       ========================================================= -->
    <div id="loader" class="loader">
        <div class="loader-inner">
            <div class="loader-logo">
                <div class="loader-hex">⬡</div>
                <span>Game<span>Verse</span></span>
            </div>
            <div class="loader-bar-wrap">
                <div class="loader-bar" id="loader-bar"></div>
            </div>
            <p class="loader-text" id="loader-text">Đang tải...</p>
        </div>
    </div>

    <!-- =========================================================
       TICKER BAR
       ========================================================= -->
    <div class="ticker-bar">
        <span class="ticker-label">🔥 HOT</span>
        <div class="ticker-track">
            <div class="ticker-inner">
                <span>🎮 Void Strike Season 3 bắt đầu – Tham gia nhận phần thưởng!</span>
                <span>🎁 Đăng ký hôm nay – Nhận 30 ngày VIP miễn phí!</span>
                <span>🏆 Kingdom Fall: Empire Wars – Cập nhật DLC mới!</span>
                <span>⚡ Flash Sale: Giảm 50% tất cả game trong 24h!</span>
                <span>🎮 Void Strike Season 3 bắt đầu – Tham gia nhận phần thưởng!</span>
                <span>🎁 Đăng ký hôm nay – Nhận 30 ngày VIP miễn phí!</span>
                <span>🏆 Kingdom Fall: Empire Wars – Cập nhật DLC mới!</span>
                <span>⚡ Flash Sale: Giảm 50% tất cả game trong 24h!</span>
            </div>
        </div>
    </div>

    <!-- =========================================================
       NAVBAR
       ========================================================= -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <a href="#" class="nav-logo">
                <div class="nav-logo-hex">⬡</div>
                <span>Game<span>Verse</span></span>
            </a>

            <ul class="nav-links" id="main-nav-links">
                <li><a href="#hero" class="nav-link active" data-section="hero">Trang Chủ</a></li>
                <li class="nav-item has-dropdown">
                    <a href="#genres-section" class="nav-link" data-section="genres-section">Thể Loại <svg class="chevron" viewBox="0 0 20 20" fill="currentColor"><path d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg></a>
                    <ul class="nav-dropdown">
                        <li><a href="#games-section" data-genre-nav="rpg">🗡️ RPG</a></li>
                        <li><a href="#games-section" data-genre-nav="shooter">🎯 Bắn Súng</a></li>
                        <li><a href="#games-section" data-genre-nav="strategy">♟️ Chiến Thuật</a></li>
                        <li><a href="#games-section" data-genre-nav="racing">🚗 Đua Xe</a></li>
                        <li><a href="#games-section" data-genre-nav="sports">🌍 Thể Thao</a></li>
                        <li><a href="#games-section" data-genre-nav="horror">👻 Kinh Dị</a></li>
                    </ul>
                </li>
                <li><a href="#spotlight-section" class="nav-link" data-section="spotlight-section">Nổi Bật</a></li>
                <li><a href="#esports-section" class="nav-link" data-section="esports-section">Esports</a></li>
                <li><a href="#news-section" class="nav-link" data-section="news-section">Tin Tức</a></li>
                <li><a href="#games-section" class="nav-link" data-section="games-section">Thư Viện</a></li>
            </ul>

            <div class="nav-right">
                <button class="nav-icon-btn" id="btn-notif" title="Thông báo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
                    <span class="nav-badge" id="notif-badge">3</span>
                </button>
                <button class="nav-icon-btn" id="btn-cart" title="Giỏ hàng">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
                    <span class="nav-badge" id="cart-badge">2</span>
                </button>
                <button class="btn-nav-cta" id="btn-nav-play">Chơi Ngay ▶</button>
                <button class="hamburger" id="hamburger">
                    <span></span><span></span><span></span>
                </button>

                <!-- Notification Dropdown -->
                <div class="notif-dropdown" id="notif-dropdown">
                    <div class="notif-header">
                        <div class="notif-title">
                            <span class="notif-icon-head">🔔</span>
                            <span>Thông Báo Mới</span>
                            <span class="notif-badge-pill" id="notif-pill">3 Mới</span>
                        </div>
                        <button class="notif-mark-btn" id="btn-mark-all-read">Đã đọc tất cả</button>
                    </div>
                    <div class="notif-items" id="notif-items">
                        <div class="notif-card unread" data-action="scroll" data-target="#games-section">
                            <div class="notif-card-icon notif-purple">🎮</div>
                            <div class="notif-card-body">
                                <strong>Void Strike: Season 3</strong>
                                <p>Mùa giải xếp hạng 2026 chính thức khởi tranh. Nhận trang phục độc quyền!</p>
                                <span class="notif-card-time">5 phút trước</span>
                            </div>
                            <span class="notif-status-dot"></span>
                        </div>
                        <div class="notif-card unread" data-action="scroll" data-target="#cta-section">
                            <div class="notif-card-icon notif-cyan">🎁</div>
                            <div class="notif-card-body">
                                <strong>GameVerse VIP 30 Ngày</strong>
                                <p>Bạn vừa nhận được gói VIP 30 ngày trải nghiệm toàn bộ 500+ game miễn phí.</p>
                                <span class="notif-card-time">1 giờ trước</span>
                            </div>
                            <span class="notif-status-dot"></span>
                        </div>
                        <div class="notif-card unread" data-action="scroll" data-target="#esports-section">
                            <div class="notif-card-icon notif-gold">🏆</div>
                            <div class="notif-card-body">
                                <strong>Grand Championship 2026</strong>
                                <p>Mở cổng đăng ký giải đấu toàn quốc tổng giải thưởng 1 tỷ VNĐ.</p>
                                <span class="notif-card-time">Hôm nay</span>
                            </div>
                            <span class="notif-status-dot"></span>
                        </div>
                    </div>
                    <div class="notif-footer">
                        <a href="#news-section" id="notif-see-all">Xem tất cả tin tức & sự kiện →</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <!-- =========================================================
       HERO SECTION
       ========================================================= -->
    <section class="hero" id="hero">
        <canvas id="particles-canvas" class="hero-particles"></canvas>
        <div class="hero-bg">
            <img src="~/images/gaming_hero_banner.jpg" alt="GameVerse Hero" class="hero-bg-img" />
            <div class="hero-overlay"></div>
            <div class="hero-grid-overlay"></div>
        </div>

        <!-- Floating Game Cards -->
        <div class="hero-floats">
            <div class="float-card float-card-1">
                <img src="~/images/game_rpg_cover.jpg" alt="" />
                <div class="float-card-info"><strong>Dragon Realm</strong><span>⭐ 9.4</span></div>
            </div>
            <div class="float-card float-card-2">
                <img src="~/images/game_shooter_cover.jpg" alt="" />
                <div class="float-card-info"><strong>Void Strike</strong><span>⭐ 9.1</span></div>
            </div>
            <div class="float-card float-card-3">
                <img src="~/images/game_horror_cover.jpg" alt="" />
                <div class="float-card-info"><strong>Shadow Hospital</strong><span>⭐ 9.2</span></div>
            </div>
        </div>

        <div class="hero-content">
            <div class="hero-badge">🔥 #1 Nền Tảng Game Việt Nam 2026</div>
            <h1 class="hero-title">
                <span class="hero-line-1">Khám Phá</span>
                <span class="hero-line-2">Thế Giới Game</span>
                <span class="hero-line-3 gradient-text">Đỉnh Cao</span>
            </h1>
            <p class="hero-desc">Hơn <strong>500+ tựa game</strong> đỉnh cao từ RPG, Shooter, Esports cho đến Chiến Thuật — tất cả trong một nền tảng duy nhất. Trải nghiệm gaming như chưa bao giờ có.</p>

            <!-- Search Bar inside Hero -->
            <div class="search-bar" id="search-bar">
                <div class="search-inner">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    <input type="text" id="search-input" placeholder="Tìm game, thể loại, nhà phát hành..." autocomplete="off" />
                    <button class="search-btn">Tìm</button>
                </div>
                <ul class="search-suggestions" id="search-suggestions"></ul>
            </div>

            <div class="hero-btns">
                <button class="btn-primary" id="btn-hero-explore">🎮 Khám Phá Ngay</button>
                <button class="btn-secondary" id="btn-hero-trailer">▶ Xem Trailer</button>
            </div>

            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="stat-num">500+</span>
                    <span class="stat-label">Tựa Game</span>
                </div>
                <div class="stat-divider"></div>
                <div class="hero-stat">
                    <span class="stat-num">2M+</span>
                    <span class="stat-label">Game Thủ</span>
                </div>
                <div class="stat-divider"></div>
                <div class="hero-stat">
                    <span class="stat-num">50+</span>
                    <span class="stat-label">Giải Đấu</span>
                </div>
                <div class="stat-divider"></div>
                <div class="hero-stat">
                    <span class="stat-num">4.9★</span>
                    <span class="stat-label">Đánh Giá</span>
                </div>
            </div>

            <div class="hero-online-bar">
                <span class="online-dot"></span>
                <span>GameVerse 2026 – Hơn <strong>2M+</strong> game thủ đang online</span>
            </div>
        </div>

        <div class="hero-scroll">
            <div class="scroll-line"></div>
            <span>Cuộn Xuống</span>
        </div>
    </section>

    <!-- =========================================================
       GENRES BENTO GRID
       ========================================================= -->
    <section class="genres-section" id="genres-section">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">🎮 Thể Loại</span>
                <h2 class="section-title">Khám Phá <span class="gradient-text">Mọi Thể Loại</span></h2>
                <p class="section-desc">Từ phiêu lưu hành động đến chiến lược đỉnh cao, chúng tôi có tất cả.</p>
            </div>

            <div class="genres-bento">
                <div class="genre-card genre-rpg" data-genre-card="rpg" title="Xem game RPG">
                    <div class="genre-img-wrap">
                        <img src="~/images/game_rpg_cover.jpg" alt="RPG" />
                    </div>
                    <div class="genre-info">
                        <div class="genre-icon">🗡️</div>
                        <h3>RPG</h3>
                        <p>120+ game</p>
                    </div>
                    <div class="genre-hover-overlay"></div>
                </div>
                <div class="genre-card genre-shooter" data-genre-card="shooter" title="Xem game Bắn Súng">
                    <div class="genre-img-wrap">
                        <img src="~/images/game_shooter_cover.jpg" alt="Shooter" />
                    </div>
                    <div class="genre-info">
                        <div class="genre-icon">🎯</div>
                        <h3>Bắn Súng</h3>
                        <p>95+ game</p>
                    </div>
                    <div class="genre-hover-overlay"></div>
                </div>
                <div class="genre-card genre-strategy" data-genre-card="strategy" title="Xem game Chiến Thuật">
                    <div class="genre-img-wrap">
                        <img src="~/images/game_strategy_cover.jpg" alt="Strategy" />
                    </div>
                    <div class="genre-info">
                        <div class="genre-icon">♟️</div>
                        <h3>Chiến Thuật</h3>
                        <p>80+ game</p>
                    </div>
                    <div class="genre-hover-overlay"></div>
                </div>
                <div class="genre-card genre-sports" data-genre-card="sports" title="Xem game Thể Thao">
                    <div class="genre-img-wrap">
                        <img src="~/images/game_sports_cover.jpg" alt="Sports" />
                    </div>
                    <div class="genre-info">
                        <div class="genre-icon">🌍</div>
                        <h3>Thể Thao</h3>
                        <p>60+ game</p>
                    </div>
                    <div class="genre-hover-overlay"></div>
                </div>
                <div class="genre-card genre-horror" data-genre-card="horror" title="Xem game Kinh Dị">
                    <div class="genre-img-wrap">
                        <img src="~/images/game_horror_cover.jpg" alt="Horror" />
                    </div>
                    <div class="genre-info">
                        <div class="genre-icon">👻</div>
                        <h3>Kinh Dị</h3>
                        <p>45+ game</p>
                    </div>
                    <div class="genre-hover-overlay"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================================
       SPOTLIGHT TABS
       ========================================================= -->
    <section class="spotlight-section" id="spotlight-section">
        <div class="container">
            <div class="section-header">
                <span class="section-tag">⭐ Nổi Bật</span>
                <h2 class="section-title">Game <span class="gradient-text">Được Yêu Thích</span></h2>
            </div>

            <div class="spotlight-tabs">
                <button class="spotlight-tab active" data-tab="new">🆕 Mới Nhất</button>
                <button class="spotlight-tab" data-tab="top">🏆 Top Rated</button>
                <button class="spotlight-tab" data-tab="free">🆓 Miễn Phí</button>
                <button class="spotlight-tab" data-tab="sale">🔥 Đang Giảm Giá</button>
            </div>

            <!-- Panel: Mới Nhất -->
            <div class="spotlight-panel active" id="panel-new">
                <div class="spotlight-grid">
                    <div class="spotlight-card spotlight-main">
                        <div class="spotlight-card-img">
                            <img src="~/images/game_rpg_cover.jpg" alt="" />
                            <div class="spotlight-card-badge new">MỚI</div>
                        </div>
                        <div class="spotlight-card-body">
                            <span class="spotlight-genre">RPG • Open World</span>
                            <h3>Dragon Realm Chronicles</h3>
                            <div class="spotlight-meta">
                                <span class="spotlight-rating">⭐ 9.4 / 10</span>
                                <span class="spotlight-players">👥 2.1M người chơi</span>
                            </div>
                            <p class="spotlight-desc">Phiêu lưu sử thi trong vương quốc rồng huyền bí. Hệ thống chiến đấu đột phá, thế giới mở rộng lớn và cốt truyện sâu sắc chưa từng có.</p>
                            <div class="spotlight-actions">
                                <button class="btn-spotlight-primary">🎮 Chơi Ngay</button>
                                <button class="btn-spotlight-secondary">📋 Chi Tiết</button>
                                <button class="btn-spotlight-wish">♡</button>
                            </div>
                        </div>
                    </div>
                    <div class="spotlight-sidebar">
                        <div class="spotlight-mini">
                            <img src="~/images/game_shooter_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">SHOOTER</span>
                                <strong>Void Strike Ops</strong>
                                <span>⭐ 9.1</span>
                            </div>
                        </div>
                        <div class="spotlight-mini">
                            <img src="~/images/game_strategy_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">STRATEGY</span>
                                <strong>Kingdom Fall</strong>
                                <span>⭐ 8.8</span>
                            </div>
                        </div>
                        <div class="spotlight-mini">
                            <img src="~/images/game_horror_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">HORROR</span>
                                <strong>Shadow Hospital</strong>
                                <span>⭐ 9.2</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel: Top Rated -->
            <div class="spotlight-panel" id="panel-top">
                <div class="spotlight-grid">
                    <div class="spotlight-card spotlight-main">
                        <div class="spotlight-card-img">
                            <img src="~/images/game_rpg_cover.jpg" alt="" />
                            <div class="spotlight-card-badge hot">TOP #1</div>
                        </div>
                        <div class="spotlight-card-body">
                            <span class="spotlight-genre">RPG • Souls-like</span>
                            <h3>Elden Forge</h3>
                            <div class="spotlight-meta">
                                <span class="spotlight-rating">⭐ 9.6 / 10</span>
                                <span class="spotlight-players">👥 3.4M người chơi</span>
                            </div>
                            <p class="spotlight-desc">Hành trình vào vùng đất đen tối đầy thử thách với gameplay cực kỳ khó và thỏa mãn. Game được đánh giá cao nhất năm 2024.</p>
                            <div class="spotlight-actions">
                                <button class="btn-spotlight-primary">🎮 Chơi Ngay</button>
                                <button class="btn-spotlight-secondary">📋 Chi Tiết</button>
                                <button class="btn-spotlight-wish">♡</button>
                            </div>
                        </div>
                    </div>
                    <div class="spotlight-sidebar">
                        <div class="spotlight-mini">
                            <img src="~/images/game_horror_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">HORROR</span>
                                <strong>Shadow Hospital</strong>
                                <span>⭐ 9.2</span>
                            </div>
                        </div>
                        <div class="spotlight-mini">
                            <img src="~/images/game_rpg_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">RPG</span>
                                <strong>Dragon Realm</strong>
                                <span>⭐ 9.4</span>
                            </div>
                        </div>
                        <div class="spotlight-mini">
                            <img src="~/images/game_shooter_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">SHOOTER</span>
                                <strong>Void Strike Ops</strong>
                                <span>⭐ 9.1</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel: Miễn Phí -->
            <div class="spotlight-panel" id="panel-free">
                <div class="spotlight-grid">
                    <div class="spotlight-card spotlight-main">
                        <div class="spotlight-card-img">
                            <img src="~/images/game_shooter_cover.jpg" alt="" />
                            <div class="spotlight-card-badge free">FREE</div>
                        </div>
                        <div class="spotlight-card-body">
                            <span class="spotlight-genre">SHOOTER • Battle Royale</span>
                            <h3>Tactical Warzone</h3>
                            <div class="spotlight-meta">
                                <span class="spotlight-rating">⭐ 8.7 / 10</span>
                                <span class="spotlight-players">👥 6.1M người chơi</span>
                            </div>
                            <p class="spotlight-desc">Battle Royale miễn phí với 100 người chơi, bản đồ khổng lồ và vũ khí đa dạng. Trải nghiệm đỉnh cao hoàn toàn không tốn phí.</p>
                            <div class="spotlight-actions">
                                <button class="btn-spotlight-primary">🎮 Tải Miễn Phí</button>
                                <button class="btn-spotlight-secondary">📋 Chi Tiết</button>
                                <button class="btn-spotlight-wish">♡</button>
                            </div>
                        </div>
                    </div>
                    <div class="spotlight-sidebar">
                        <div class="spotlight-mini">
                            <img src="~/images/game_sports_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">SPORTS</span>
                                <strong>FIFA Ultimate</strong>
                                <span>⭐ 8.5</span>
                            </div>
                        </div>
                        <div class="spotlight-mini">
                            <img src="~/images/game_strategy_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">STRATEGY</span>
                                <strong>Kingdom Fall</strong>
                                <span>⭐ 8.8</span>
                            </div>
                        </div>
                        <div class="spotlight-mini">
                            <img src="~/images/game_horror_cover.jpg" alt="" />
                            <div class="spotlight-mini-info">
                                <span class="spotlight-mini-genre">HORROR</span>
                                <strong>Haunted Manor</strong>
                                <span>⭐ 8.9</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel: Đang Giảm Giá -->
            <div class="spotlight-panel" id="panel-sale">
                <div class="spotlight-grid">
                    <div class="spotlight-card spotlight-main">
                        <div class="spotlight-card-img">
                            <img src="~/images/game_strategy_cover.jpg" alt="" />
                            <div class="spotlight-card-badge sale">-70%</div>
                        </div>
                        <div class="spotlight-card-body">
                            <span class="spotlight-genre">STRATEGY • Medieval</span>
